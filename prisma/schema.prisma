generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  phone              String?             @unique
  name               String?
  image              String?
  role               Role                @default(STUDENT)
  locale             String              @default("ru")
  passwordHash       String?
  passwordChangedAt  DateTime?
  firstName          String?
  lastName           String?
  email              String?             @unique
  emailVerified      DateTime?
  phoneVerified      DateTime?
  avatarSkinId       String?
  enrollments        Enrollment[]
  submissions        Submission[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  Payment            Payment[]
  LessonProgress     LessonProgress[]
  tokens             VerificationToken[]
  oauthAccounts      OAuthAccount[]
  groups             Group[]             @relation("TeacherGroups")
  groupMemberships   GroupMembership[]   @relation("GroupMemberships")
  attendanceRecords  Attendance[]        @relation("AttendanceRecords")
  devices            UserDevice[]
  achievements       UserAchievement[]
  examAttempts       ExamAttempt[]       @relation("ExamAttempts")
  examReviews        ExamAttempt[]       @relation("ExamReviewer")
  dialogueAttempts   DialogueAttempt[]
  monthlyReports     MonthlyReport[]     @relation("MonthlyReports")
  authoredReports    MonthlyReport[]     @relation("MonthlyReportAuthor")
  certificates       Certificate[]       @relation("Certificates")
  issuedCertificates Certificate[]       @relation("CertificateIssuer")

  @@index([phone])
  @@index([email])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model UserDevice {
  id                    String         @id @default(cuid())
  userId                String
  userAgent             String?
  ip                    String?
  platform              DevicePlatform @default(WEB)
  clientDeviceId        String?
  refreshTokenHash      String?
  refreshTokenExpiresAt DateTime?
  firstSeenAt           DateTime       @default(now())
  lastSeenAt            DateTime       @default(now())
  revokedAt             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientDeviceId])
  @@index([userId, revokedAt])
}

enum DevicePlatform {
  WEB
  IOS
  ANDROID
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model PhoneCode {
  id          String           @id @default(cuid())
  phone       String
  purpose     PhoneCodePurpose
  codeHash    String
  attempts    Int              @default(0)
  maxAttempts Int              @default(5)
  verifiedAt  DateTime?
  consumedAt  DateTime?
  userId      String?
  ip          String?
  expiresAt   DateTime
  createdAt   DateTime         @default(now())

  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
}

model RateLimit {
  id      String   @id @default(cuid())
  bucket  String   @unique
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

model VerificationToken {
  id        String            @id @default(cuid())
  token     String            @unique
  purpose   EmailTokenPurpose @default(EMAIL_VERIFY)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id])

  @@index([userId, purpose])
  @@index([expiresAt])
}

enum EmailTokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model Course {
  id           String           @id @default(cuid())
  slug         String           @unique
  title        Json
  description  Json
  priceBasic   Int              @default(200000)
  pricePro     Int              @default(400000)
  priceDeluxe  Int              @default(800000)
  lessons      Lesson[]
  modules      Module[]
  level        String           @default("Beginner")
  coverUrl     String?
  badge        String?
  published    Boolean          @default(false)
  visible      Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  Enrollment   Enrollment[]
  Payment      Payment[]
  leads        ContactRequest[]
  certificates Certificate[]
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  title       Json
  description Json?
  order       Int      @default(0)
  course      Course   @relation(fields: [courseId], references: [id])
  lessons     Lesson[]
  exam        Exam?

  @@index([courseId, order])
}

model Lesson {
  id             String           @id @default(cuid())
  courseId       String
  moduleId       String?
  slug           String
  title          Json
  content        Json
  videoUrl       String?
  coverUrl       String?
  durationMin    Int?
  hasVideo       Boolean          @default(true)
  hasConspect    Boolean          @default(false)
  hasTest        Boolean          @default(false)
  hasDialogue    Boolean          @default(false)
  zoomMeetingId  String?
  order          Int              @default(0)
  course         Course           @relation(fields: [courseId], references: [id])
  module         Module?          @relation(fields: [moduleId], references: [id])
  Assignment     Assignment[]
  LessonProgress LessonProgress[]
  Dialogue       Dialogue[]

  @@unique([courseId, slug])
  @@index([moduleId, order])
}

model Exam {
  id           String   @id @default(cuid())
  moduleId     String   @unique
  title        Json
  prompt       Json
  answerKey    Json?
  passingScore Int      @default(70)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  module   Module        @relation(fields: [moduleId], references: [id])
  attempts ExamAttempt[]
}

model ExamAttempt {
  id           String           @id @default(cuid())
  examId       String
  userId       String
  answer       Json
  grade        Int
  correct      Int
  total        Int
  submittedAt  DateTime         @default(now())
  reviewStatus ExamReviewStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  exam       Exam  @relation(fields: [examId], references: [id])
  user       User  @relation("ExamAttempts", fields: [userId], references: [id])
  reviewedBy User? @relation("ExamReviewer", fields: [reviewedById], references: [id])

  @@index([examId, userId, submittedAt])
  @@index([reviewStatus])
}

enum ExamReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Dialogue {
  id         String   @id @default(cuid())
  lessonId   String
  title      Json
  characters Json
  lines      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lesson   Lesson            @relation(fields: [lessonId], references: [id])
  attempts DialogueAttempt[]
}

model DialogueAttempt {
  id          String                @id @default(cuid())
  dialogueId  String
  userId      String
  characterId String
  status      DialogueAttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime              @default(now())
  completedAt DateTime?

  dialogue   Dialogue                @relation(fields: [dialogueId], references: [id])
  user       User                    @relation(fields: [userId], references: [id])
  recordings DialogueLineRecording[]

  @@index([dialogueId, userId])
}

model DialogueLineRecording {
  id          String   @id @default(cuid())
  attemptId   String
  lineId      String
  audioUrl    String
  durationSec Int?
  createdAt   DateTime @default(now())

  attempt DialogueAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, lineId])
  @@index([attemptId])
}

enum DialogueAttemptStatus {
  IN_PROGRESS
  COMPLETED
}

model Enrollment {
  id            String           @id @default(cuid())
  userId        String
  courseId      String
  status        EnrollmentStatus @default(ACTIVE)
  plan          Plan?
  lastLessonId  String?
  lastVisitedAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt
  user          User             @relation(fields: [userId], references: [id])
  course        Course           @relation(fields: [courseId], references: [id])

  @@index([userId, status])
}

model Assignment {
  id          String       @id @default(cuid())
  lessonId    String
  title       Json
  prompt      Json
  answerKey   Json?
  lesson      Lesson       @relation(fields: [lessonId], references: [id])
  submissions Submission[]
}

model Submission {
  id           String     @id @default(cuid())
  assignmentId String
  userId       String
  answer       Json
  grade        Int?
  createdAt    DateTime   @default(now())
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  user         User       @relation(fields: [userId], references: [id])
}

model Payment {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  provider    String
  providerRef String
  amountCents Int
  currency    String
  status      String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  course      Course   @relation(fields: [courseId], references: [id])
}

model LessonProgress {
  id        String    @id @default(cuid())
  userId    String
  lessonId  String
  watched   Boolean   @default(false)
  passed    Boolean   @default(false)
  passedAt  DateTime?
  lastStep  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])
  lesson    Lesson    @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
  @@index([userId, passedAt])
}

model Stream {
  id          String     @id @default(cuid())
  title       Json
  description Json
  kind        StreamKind @default(YOUTUBE)

  youtubeId   String?
  zoomJoinUrl String?

  startsAt    DateTime
  durationMin Int      @default(60)

  recordingUrl String?

  requiredPlan Plan?

  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt])
  @@index([published])
}

enum StreamKind {
  YOUTUBE
  ZOOM
}

model News {
  id   String @id @default(cuid())
  slug String @unique

  title Json
  lead  Json
  body  Json

  metaTitle       Json?
  metaDescription Json?
  coverUrl        String?

  // Set when the item was imported from Instagram: the post id (to import it
  // once) and its link (to send people to the video or the full carousel).
  instagramId  String? @unique
  instagramUrl String?

  published   Boolean   @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, publishedAt])
}

// Small key-value store for integration state that must survive deploys:
// the auto-refreshed Instagram token, the time of the last sync and its error.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ContactRequest {
  id        String        @id @default(cuid())
  firstName String
  // Nullable since the campaign landings (/l/[campaign]) ask for a name and a
  // phone number and nothing else. Readers must not interpolate it directly.
  lastName  String?
  phone     String
  email     String?
  message   String?
  source    LeadSource    @default(HOME_FORM)
  // Slug from src/content/campaigns.json, set only when source = LANDING.
  campaign  String?
  utm       Json?
  courseId  String?
  plan      Plan?
  locale    String        @default("ru")
  ip        String?
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  course    Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([courseId])
  @@index([campaign])
}

enum Role {
  ADMIN
  MENTOR
  STUDENT
}

// --- Teacher panel: groups, schedule, attendance -----------------------

model Group {
  id        String   @id @default(cuid())
  teacherId String
  name      String
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher User              @relation("TeacherGroups", fields: [teacherId], references: [id])
  members GroupMembership[]
  events  ScheduleEvent[]
  reports MonthlyReport[]

  @@index([teacherId, archived])
}

model GroupMembership {
  id       String    @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation("GroupMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId, leftAt])
}

enum ScheduleEventType {
  LESSON
  MOCK_TEST
  EXAM
  SPEAKING_PRACTICE
  OTHER
}

model ScheduleEvent {
  id          String            @id @default(cuid())
  groupId     String
  type        ScheduleEventType @default(LESSON)
  title       String?
  notes       String?
  startsAt    DateTime
  durationMin Int               @default(60)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  group      Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  attendance Attendance[]

  @@index([groupId, startsAt])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Attendance {
  id        String           @id @default(cuid())
  eventId   String
  userId    String
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  event ScheduleEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User          @relation("AttendanceRecords", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

// --- Public documents: parent reports, certificates --------------------
//
// Both carry their own public link. Deliberately not reusing VerificationToken:
// that model is one-shot and expiring (usedAt / expiresAt, built for email
// confirmation). These links are long-lived, viewed repeatedly by someone who
// never signs in, and revocable by the person who issued them.

model MonthlyReport {
  id      String @id @default(cuid())
  userId  String
  // A student in two groups gets one report per group.
  groupId String

  periodStart DateTime
  periodEnd   DateTime

  // Frozen snapshot, written once at generation time. A March report must not
  // drift when April's attendance lands, and the teacher's comment is written
  // against the numbers they actually saw. Regeneration overwrites a DRAFT and
  // refuses to touch a PUBLISHED report.
  data    Json
  comment String?

  status      MonthlyReportStatus @default(DRAFT)
  token       String              @unique
  publishedAt DateTime?
  revokedAt   DateTime?

  viewCount    Int       @default(0)
  lastViewedAt DateTime?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User  @relation("MonthlyReports", fields: [userId], references: [id], onDelete: Cascade)
  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User  @relation("MonthlyReportAuthor", fields: [createdById], references: [id])

  @@unique([userId, groupId, periodStart])
  @@index([groupId, periodStart])
  @@index([status])
}

enum MonthlyReportStatus {
  DRAFT
  PUBLISHED
}

model Certificate {
  id       String @id @default(cuid())
  userId   String
  courseId String
  level    String

  // Unguessable on its own, which is why verification needs no date-of-birth
  // gate — we do not store birth dates and should not start collecting them.
  serial String @unique

  issuedAt   DateTime  @default(now())
  issuedById String
  // A revoked certificate stays visible as revoked. "Issued and withdrawn" is
  // different information from "never existed".
  revokedAt  DateTime?
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User   @relation("Certificates", fields: [userId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id])
  issuedBy User   @relation("CertificateIssuer", fields: [issuedById], references: [id])

  @@index([userId])
  @@index([courseId])
}

enum Plan {
  FREE
  BASIC
  PRO
  DELUXE
}

enum EnrollmentStatus {
  ACTIVE
  CANCELED
}

enum ContactStatus {
  NEW
  CONTACTED
  RESOLVED
  SPAM
}

enum PhoneCodePurpose {
  REGISTER
  BIND
  RESET
}

enum LeadSource {
  HOME_FORM
  COURSE_PAGE
  CONTACTS_PAGE
  TRIAL_LESSON
  LEVEL_TEST
  LANDING
}
