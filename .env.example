# Шаблон переменных окружения. Скопируй в .env и подставь реальные значения.
# .env в git НЕ попадает. На проде значения задаются в панели Vercel.
# Каждая переменная объявляется РОВНО ОДИН раз — при дубле побеждает последняя.
#
# Переменные с префиксом NEXT_PUBLIC_ уезжают в браузер и вшиваются В МОМЕНТ
# СБОРКИ. Добавить такую в Vercel и не пересобрать — то же самое, что не
# добавлять. Секреты с этим префиксом не пишем никогда.

# --- База данных ---------------------------------------------------------
DATABASE_URL=

# --- NextAuth ------------------------------------------------------------
# Секрет для подписи JWT-сессий. Сгенерировать: openssl rand -base64 32
# Кто знает этот секрет — может войти под любым пользователем, включая ADMIN.
# Менять только осознанно: смена разлогинивает всех разом.
NEXTAUTH_SECRET=
# Адрес сайта: локально http://localhost:3000, на проде https://vertexedu.uz
# Из него собираются ссылки в письмах и адрес возврата от Google.
NEXTAUTH_URL=

# --- Мобильное приложение (bearer-токены) ---------------------------------
# Секрет для подписи access-токенов мобильного приложения. Отдельно от
# NEXTAUTH_SECRET специально: ротация одного не разлогинивает другой канал.
# Сгенерировать: openssl rand -base64 32
MOBILE_AUTH_SECRET=

# --- Вход через Google ----------------------------------------------------
# Где взять: console.cloud.google.com -> APIs & Services -> Credentials ->
# Create credentials -> OAuth client ID -> Web application.
#
# Authorized redirect URIs должны совпадать до символа, оба:
#   http://localhost:3000/api/auth/callback/google
#   https://vertexedu.uz/api/auth/callback/google
#
# Провайдер подключается, только если заданы ОБЕ переменные ниже. Если пусто —
# кнопки Google просто нет, ничего не ломается.
# NEXT_PUBLIC_GOOGLE_ENABLED отвечает за показ кнопки в браузере и должен
# совпадать по смыслу с наличием ключей.
NEXT_PUBLIC_GOOGLE_ENABLED=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Защита от ботов: Cloudflare Turnstile --------------------------------
# Где взять: dash.cloudflare.com -> Turnstile -> Add widget.
# Домены: vertexedu.uz и отдельной строкой localhost. Режим Managed.
#
# Поведение при пустом TURNSTILE_SECRET_KEY:
#   локально  — проверка пропускается, чтобы не мешать разработке;
#   на проде  — защищённые формы ОТКАЗЫВАЮТ.
# Это сознательно: молчаливый пропуск означал бы, что защита однажды тихо
# исчезнет из-за пустой переменной и никто не заметит. Поэтому выкатывать на
# Vercel нужно ВМЕСТЕ с заданными ключами, иначе форма заявки перестанет
# принимать что-либо.
#
# Тестовые ключи Cloudflare для отладки:
#   сайт   1x00000000000000000000AA  (всегда успех)
#   секрет 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- SMS: Eskiz.uz -------------------------------------------------------
# Кабинет: my.eskiz.uz. Логин и пароль от кабинета, не токен — токен код
# получает сам и кеширует.
#
# ESKIZ_TEST_MODE=true — реальный код НЕ отправляется, вместо текста уходит
# согласованная строка "This is test from Eskiz", а сам код печатается в
# консоль сервера (только вне продакшна). Ошибки отправки при этом не роняют
# регистрацию.
# НА ПРОДЕ ОБЯЗАТЕЛЬНО false. Если оставить true, живым людям вместо кода
# придёт тестовая строка и зарегистрироваться не сможет никто.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_TEST_MODE=

# --- Почта: SMTP ---------------------------------------------------------
# Нужна РОВНО для двух вещей:
#   1. письмо со ссылкой подтверждения при регистрации по почте;
#   2. ссылка восстановления пароля по почте.
# Регистрация по телефону и вход через Google работают без неё полностью.
#
# Где взять — любой SMTP-релей, например:
#   Brevo    smtp-relay.brevo.com  порт 587  SECURE=false  (бесплатный тариф)
#   Resend   smtp.resend.com       порт 587  SECURE=false  (user: resend)
#   Yandex   smtp.yandex.ru        порт 465  SECURE=true
# SMTP_SECURE=true только для порта 465. Для 587 — false, там STARTTLS.
#
# EMAIL_FROM должен быть на домене, подтверждённом у провайдера, иначе письма
# уйдут в спам или будут отклонены.
#
# Пока SMTP_HOST пуст, письма не отправляются, и интерфейс говорит об этом
# честно, а не делает вид, что письмо ушло.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Vertex <no-reply@vertexedu.uz>"

# Показывать способ "по электронной почте" в регистрации и восстановлении
# пароля. Включать ТОЛЬКО когда SMTP выше заполнен и проверен: без него
# аккаунт создастся, но войти в него будет нельзя, пока не подтверждена почта.
NEXT_PUBLIC_EMAIL_ENABLED=

# --- Платежи: Payme ------------------------------------------------------
PAYME_MERCHANT_ID=
# 1 — тестовая касса checkout.test.paycom.uz, 0 — боевая
PAYME_TEST_MODE=

# --- Платежи: Click ------------------------------------------------------
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_GATEWAY_URL=

# --- Zoom (стримы) -------------------------------------------------------
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=
