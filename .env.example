# Шаблон переменных окружения. Скопируй в .env и подставь реальные значения.
# .env в git НЕ попадает. На проде значения задаются в панели Vercel.
# Каждая переменная объявляется РОВНО ОДИН раз — при дубле побеждает последняя.

# --- База данных ---------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- NextAuth ------------------------------------------------------------
# Секрет для подписи JWT-сессий. Сгенерировать: openssl rand -base64 32
# Кто знает этот секрет — может войти под любым пользователем, включая ADMIN.
NEXTAUTH_SECRET=
# Адрес сайта: локально http://localhost:3000, на проде https://vertexedu.uz
NEXTAUTH_URL=http://localhost:3000

# --- SMS: Eskiz.uz -------------------------------------------------------
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# true — OTP не отправляется реально, ошибки SMS не роняют регистрацию
ESKIZ_TEST_MODE=true

# --- Платежи: Payme ------------------------------------------------------
PAYME_MERCHANT_ID=
# 1 — тестовая касса checkout.test.paycom.uz, 0 — боевая
PAYME_TEST_MODE=1

# --- Платежи: Click ------------------------------------------------------
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_GATEWAY_URL=https://my.click.uz/services/pay

# --- Zoom (стримы) -------------------------------------------------------
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=
